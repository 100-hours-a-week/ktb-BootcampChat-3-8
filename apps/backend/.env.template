# Copy this file to .env and adjust values for your environment

ENCRYPTION_KEY=change_me_64_hex_chars____________________________________
ENCRYPTION_SALT=change_me_32_hex_chars________________
JWT_SECRET=change_me_secure_jwt_secret

# MongoDB Configuration
# Mode: standalone (로컬 개발) 또는 replica (프로덕션)
MONGO_MODE=standalone

# Standalone 모드 (기본)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=bootcamp-chat

# 인증 정보 (필요 시)
MONGO_USERNAME=
MONGO_PASSWORD=
# 사용자가 다른 DB(admin 등)에 생성되어 있다면 authSource로 지정
MONGO_AUTH_DB=admin

# Replica Set 모드 (MONGO_MODE=replica 사용 시)
# MONGO_REPLICA_SET_NAME=rs0
# 쉼표로 구분된 host:port 목록
# MONGO_REPLICA_HOSTS=mongo-primary:27017,mongo-secondary1:27017,mongo-secondary2:27017
# 연결 옵션 (읽기, 쓰기, retry 설정 등)
# MONGO_REPLICA_OPTIONS=readPreference=primaryPreferred&w=majority&retryWrites=true

# 직접 커넥션 문자열을 지정하고 싶다면 아래 변수를 사용
# (설정 시 위의 HOST/PORT 값보다 우선 적용)
# MONGO_URI=mongodb://user:pass@localhost:27017/bootcamp-chat?replicaSet=rs0

PORT=5001
WS_PORT=5002

OPENAI_API_KEY=sk-...

# Redis Configuration
# Mode: standalone (로컬 개발) 또는 cluster (프로덕션)
REDIS_MODE=standalone

# Standalone 모드 설정 (로컬 개발용)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cluster 모드 설정 (프로덕션용 - 3-node master-replica)
# REDIS_MODE=cluster
# REDIS_CLUSTER_NODES=redis-node1:6379,redis-node2:6379,redis-node3:6379
# REDIS_PASSWORD=your-secure-password

# 공통 Redis 설정
REDIS_TIMEOUT=3000